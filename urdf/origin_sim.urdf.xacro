<?xml version='1.0'?>

<!--
Simulation overlay for the Origin One. Includes hardware description from 
origin_one_description and Gazebo plugins for simulating sensors and drive. -->

<robot name="avular_origin_one_sim" xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://sdformat.org/schemas/root.xsd">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="namespace" default="robot"/>
  <xacro:arg name="drive_configuration" default="skid_steer_drive"/>

  <xacro:include filename="$(find origin_one_description)/urdf/origin_one.urdf.xacro"/>

  <xacro:property name="namespace" value="$(arg namespace)"/>

  <xacro:macro name="wheel_friction" params="link_name fdir_y">
    <gazebo reference="${link_name}">
      <collision>
        <surface>
          <friction>
            <xacro:if value="${var == 'skid_steer_drive' or var == 'big_skid_steer_drive' or var == 'elevated_skid_steer_drive'}">
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <slip1>0.015</slip1>
                <slip2>0</slip2>
                <fdir1>0 0 1</fdir1>
              </ode>
            </xacro:if>
            <xacro:if value="${var == 'mecanum_drive'}">
              <ode>
                <mu>1</mu>
                <mu2>0</mu2>
                <fdir1 gz:expressed_in="${P}base_link">1 ${fdir_y} 0</fdir1>
              </ode>
            </xacro:if>
            <bullet>
              <friction>1</friction>
              <friction2>1</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction link_name="${P}left_front_wheel"  fdir_y="-1"/>
  <xacro:wheel_friction link_name="${P}right_front_wheel" fdir_y="1"/>
  <xacro:wheel_friction link_name="${P}left_rear_wheel"   fdir_y="1"/>
  <xacro:wheel_friction link_name="${P}right_rear_wheel"  fdir_y="-1"/>

  <xacro:macro name="diff_drive_plugin" params="wheel_radius max_linear_velocity max_angular_velocity">
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>${P}main_body_left_front_wheel</left_joint>
      <left_joint>${P}main_body_left_rear_wheel</left_joint>
      <right_joint>${P}main_body_right_front_wheel</right_joint>
      <right_joint>${P}main_body_right_rear_wheel</right_joint>
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>5.5</max_linear_acceleration>
      <min_linear_acceleration>-5.5</min_linear_acceleration>
      <max_angular_acceleration>6</max_angular_acceleration>
      <min_angular_acceleration>-6</min_angular_acceleration>
      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <min_linear_velocity>${-max_linear_velocity}</min_linear_velocity>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <min_angular_velocity>${-max_angular_velocity}</min_angular_velocity>
      <topic>/${namespace}/cmd_vel</topic>
      <odom_topic>/${namespace}/odom</odom_topic>
      <tf_topic>/${namespace}/tf</tf_topic>
      <frame_id>${P}odom</frame_id>
      <child_frame_id>${P}base_link</child_frame_id>
    </plugin>
  </xacro:macro>

  <!-- Camera (RealSense D435) and Ouster (os_imu/os_lidar) sub-frames are not
       defined here: on hardware their drivers publish them at runtime, and in
       simulation we stand in for those drivers with static_transform_publisher
       nodes in avular_simulations/origin.py (_SENSOR_STATIC_TFS). -->
  <link name="${P}lidar_link_gazebo">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <collision name="collision-base">
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.07" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint type="fixed" name="${P}lidar_joint_gazebo">
    <origin xyz="0 0 0.035" rpy="0 0 3.1416"/>
    <child link="${P}lidar_link_gazebo"/>
    <parent link="${P}ouster_base"/>
  </joint>

  <gazebo reference="${P}lidar_link_gazebo">
    <sensor name='ouster_lidar' type='gpu_lidar'>
      <topic>/${namespace}/lidar</topic>
      <gz_frame_id>${P}os_lidar</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.39</min_angle>
            <max_angle>0.39</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.08</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Ouster OS1-32 built-in IMU. Sim-only carrier link at the os_imu offset;
       data is stamped in os_imu (published as a static TF in origin.py). -->
  <link name="${P}os_imu_link_gazebo">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint type="fixed" name="${P}os_imu_joint_gazebo">
    <origin xyz="0.006253 -0.011775 0.007645" rpy="0 0 0"/>
    <parent link="${P}os_sensor"/>
    <child link="${P}os_imu_link_gazebo"/>
  </joint>

  <gazebo reference="${P}os_imu_link_gazebo">
    <sensor name="os_imu" type="imu">
      <gz_frame_id>${P}os_imu</gz_frame_id>
      <topic>/${namespace}/lidar/imu</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="${P}camera_link">
    <sensor name="realsense_d435" type="rgbd_camera">
      <gz_frame_id>${P}camera_link</gz_frame_id>
      <topic>/${namespace}/camera</topic>
      <update_rate>6</update_rate>
      <camera name="camera">
        <horizontal_fov>1.0472</horizontal_fov>
        <lens>
          <intrinsics>
            <fx>554.25469</fx>
            <fy>554.25469</fy>
            <cx>320.5</cx>
            <cy>240.5</cy>
            <s>0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="${P}gnss_link">
    <sensor name="navsat" type="navsat">
      <gz_frame_id>${P}gnss_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/${namespace}/gnss</topic>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </gps>
    </sensor>
  </gazebo>

  <!-- 
  IMU sensor - Disabled 
  <gazebo reference="${P}imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>${P}imu_link</gz_frame_id>
      <topic>/${namespace}/imu</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  -->
  <!-- Single-ray ultrasonic ranger modelled as a 1x1 gpu_lidar. -->
  <xacro:macro name="ultrasonic_sensor" params="name">
    <gazebo reference="${P}us_${name}_link">
      <sensor name="us_${name}" type="gpu_lidar">
        <gz_frame_id>${P}us_${name}_link</gz_frame_id>
        <topic>/${namespace}/us/${name}</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.001</min_angle>
              <max_angle>0.001</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>3.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:ultrasonic_sensor name="left_front"/>
  <xacro:ultrasonic_sensor name="center_front"/>
  <xacro:ultrasonic_sensor name="right_front"/>
  <xacro:ultrasonic_sensor name="left_rear"/>
  <xacro:ultrasonic_sensor name="center_rear"/>
  <xacro:ultrasonic_sensor name="right_rear"/>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${namespace}/joint_states</topic>
    </plugin>

    <xacro:if value="${var == 'skid_steer_drive'}">
      <xacro:diff_drive_plugin wheel_radius="0.120" max_linear_velocity="1.5" max_angular_velocity="2"/>
    </xacro:if>

    <xacro:if value="${var == 'big_skid_steer_drive' or var == 'elevated_skid_steer_drive'}">
      <xacro:diff_drive_plugin wheel_radius="0.165" max_linear_velocity="2.5" max_angular_velocity="3"/>
    </xacro:if>

    <xacro:if value="${var == 'mecanum_drive'}">
      <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
        <front_left_joint>${P}main_body_left_front_wheel</front_left_joint>
        <front_right_joint>${P}main_body_right_front_wheel</front_right_joint>
        <back_left_joint>${P}main_body_left_rear_wheel</back_left_joint>
        <back_right_joint>${P}main_body_right_rear_wheel</back_right_joint>
        <wheel_separation>${trackWidth}</wheel_separation>
        <wheelbase>${wheelbase}</wheelbase>
        <wheel_radius>${wheelRadius}</wheel_radius>
        <min_acceleration>-5</min_acceleration>
        <max_acceleration>5</max_acceleration>
        <topic>/${namespace}/cmd_vel</topic>
      </plugin>

      <!-- MecanumDrive does not publish odometry; use a separate plugin.
           https://github.com/gazebosim/gz-sim/pull/2297 -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/${namespace}/odom</odom_topic>
        <tf_topic>/${namespace}/tf</tf_topic>
        <odom_frame>${P}odom</odom_frame>
        <robot_base_frame>${P}base_link</robot_base_frame>
      </plugin>
    </xacro:if>
  </gazebo>

</robot>
